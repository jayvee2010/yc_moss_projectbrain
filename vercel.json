{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/styles.css", "dest": "backend/main.py" },
    { "src": "/app.js", "dest": "backend/main.py" },
    { "src": "/(.*)", "dest": "backend/main.py" }
  ]
}
