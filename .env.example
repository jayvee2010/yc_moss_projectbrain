# ProjectBrain environment keys (never commit real values)
# Copy this file to .env and fill in your keys, or paste them into
# Vercel → Settings → Environment Variables.

# Moss retrieval engine — from platform.inferedge.dev
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Google Gemini — from aistudio.google.com/apikey (needed for /ask, /check LLM judge, AI extraction)
GEMINI_API_KEY=

# Optional — GitHub personal access token for higher rate limits + private repos
GITHUB_TOKEN=

# Optional — set to 1 on Vercel to auto-seed the demo project on cold start
SEED_ON_BOOT=1

# Optional — set to 1 to let cold-start seeding also index into Moss (uses credits)
MOSS_AUTOSYNC=
